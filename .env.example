# 로컬 Docker Compose용 값이다. 운영 비밀값으로 사용하지 않는다.
PACING_POSTGRES_DATABASE=pacing
PACING_POSTGRES_USERNAME=pacing
PACING_POSTGRES_PASSWORD=pacing
PACING_POSTGRES_PORT=5432

PACING_REDIS_PASSWORD=pacing
PACING_REDIS_PORT=6379

PACING_KAFKA_PORT=9092
PACING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PACING_WORKER_PORT=8081
PACING_API_PORT=8080
PACING_GLOWROOT_API_PORT=4000
PACING_GLOWROOT_WORKER_PORT=4001

PACING_PROMETHEUS_PORT=9090
PACING_GRAFANA_PORT=3000
PACING_GRAFANA_ADMIN_USER=admin
PACING_GRAFANA_ADMIN_PASSWORD=admin

# 애플리케이션 실행 시 환경변수로 주입한다.
PACING_HMAC_AD_SERVER_CURRENT_SECRET=local-ad-server-secret-key-change-me-0001
PACING_HMAC_AUCTION_SERVER_CURRENT_SECRET=local-auction-secret-key-change-me-0001
PACING_HMAC_OPERATION_SERVER_CURRENT_SECRET=local-operation-secret-key-change-me-0001
