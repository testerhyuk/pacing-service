        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(pacing_api_reservation_seconds_bucket{application=\"pacing-api\"}[1m])))",
          "legendFormat": "Reservation p95",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pacing_api_reservation_seconds_bucket{application=\"pacing-api\"}[1m])))",
          "legendFormat": "Reservation p99",
          "refId": "D"
        }
      ],
