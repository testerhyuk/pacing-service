        {
          "expr": "sum(rate(pacing_api_decision_seconds_count{application=\"pacing-api\",outcome=\"SUCCESS\",decision=\"PASS\"}[10s])) / clamp_min(sum(rate(pacing_api_decision_seconds_count{application=\"pacing-api\",outcome=\"SUCCESS\"}[10s])), 0.001)",
          "legendFormat": "actual PASS ratio",
          "refId": "B"
        },
        {
          "expr": "max by (strategy) (pacing_api_rate_update_pass_rate{application=\"pacing-api\"})",
